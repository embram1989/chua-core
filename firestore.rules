rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // HELPER SECURITY FUNCTIONS (MULTI-TENANT & RBAC HARDENING)
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
        request.auth.token.email == 'embram1989@gmail.com' && 
        request.auth.token.email_verified == true;
    }

    // Verifikasi kepemilikan tenant: Superadmin, Custom Claim, Owner UID/Email, atau Staf Aktif
    function belongsToTenant(tenantId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        tenantId == null ||
        tenantId == '' ||
        tenantId == request.auth.uid ||
        (request.auth.token.tenantId != null && request.auth.token.tenantId == tenantId) ||
        (
          exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
          (
            get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerEmail == request.auth.token.email ||
            get(/databases/$(database)/documents/tenants/$(tenantId)).data.email == request.auth.token.email ||
            get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
          )
        ) ||
        (
          exists(/databases/$(database)/documents/users_staff/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users_staff/$(request.auth.uid)).data.isActive != false &&
          (
            get(/databases/$(database)/documents/users_staff/$(request.auth.uid)).data.tenantId == tenantId ||
            get(/databases/$(database)/documents/users_staff/$(request.auth.uid)).data.email == request.auth.token.email
          )
        )
      );
    }

    function canAccessData(resData) {
      return isSignedIn() && (
        isSuperAdmin() ||
        resData == null ||
        resData.tenantId == null ||
        resData.tenantId == '' ||
        resData.tenantId == request.auth.uid ||
        resData.ownerEmail == request.auth.token.email ||
        resData.email == request.auth.token.email ||
        belongsToTenant(resData.tenantId)
      );
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // PLATFORM, AUTH BOOTSTRAPPING & TENANT MANAGEMENT
    // -------------------------------------------------------------

    // Invitations Collection
    match /invitations/{inviteId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin() || (
        isSignedIn() && (
          (request.resource.data.tenantId != null && belongsToTenant(request.resource.data.tenantId)) || 
          (resource.data.tenantId != null && belongsToTenant(resource.data.tenantId))
        )
      );
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email || 
        belongsToTenant(resource.data.tenantId) || 
        isSuperAdmin()
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        canAccessData(resource.data)
      );
      allow write: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin()
      );
    }

    // Tenants Collection (Kediri Sport Center & GOR Tenant Lain)
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (
        request.auth.uid == tenantId || 
        resource.data.ownerEmail == request.auth.token.email ||
        resource.data.email == request.auth.token.email ||
        belongsToTenant(tenantId) || 
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() || (
          request.auth.uid == tenantId &&
          (request.resource.data.ownerEmail == request.auth.token.email || request.resource.data.email == request.auth.token.email)
        )
      );
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() && (
          request.auth.uid == tenantId || 
          resource.data.ownerEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email ||
          belongsToTenant(tenantId)
        )
      );
    }

    // Users Staff Collection
    match /users_staff/{staffId} {
      allow read: if isSignedIn() && (
        request.auth.uid == staffId || 
        resource.data.email == request.auth.token.email || 
        belongsToTenant(resource.data.tenantId) || 
        isSuperAdmin()
      );
      allow create: if isSuperAdmin() || (
        isSignedIn() && (
          request.auth.uid == request.resource.data.tenantId ||
          belongsToTenant(request.resource.data.tenantId)
        )
      );
      allow update: if isSuperAdmin() || (
        isSignedIn() && (
          request.auth.uid == resource.data.tenantId ||
          belongsToTenant(resource.data.tenantId) ||
          request.auth.uid == staffId
        )
      );
      allow delete: if isSuperAdmin() || (
        isSignedIn() && (
          request.auth.uid == resource.data.tenantId ||
          belongsToTenant(resource.data.tenantId)
        )
      );
    }

    // -------------------------------------------------------------
    // KOLEKSI CONFIG & SUPPORTING APP CLIENT
    // -------------------------------------------------------------

    // Arenas Collection
    match /arenas/{arenaId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, delete: if isSignedIn() && (canAccessData(resource.data) || request.auth.uid == settingId);
      allow create: if isSignedIn() && (canAccessData(request.resource.data) || request.auth.uid == settingId);
      allow update: if isSignedIn() && (canAccessData(resource.data) || request.auth.uid == settingId);
    }

    // Tenant Settings Collection
    match /tenant_settings/{settingId} {
      allow read, delete: if isSignedIn() && (canAccessData(resource.data) || request.auth.uid == settingId);
      allow create: if isSignedIn() && (canAccessData(request.resource.data) || request.auth.uid == settingId);
      allow update: if isSignedIn() && (canAccessData(resource.data) || request.auth.uid == settingId);
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow read, delete: if isSignedIn() && (canAccessData(resource.data) || request.auth.uid == resource.data.tenantId);
      allow create: if isSignedIn() && (canAccessData(request.resource.data) || request.auth.uid == request.resource.data.tenantId);
      allow update: if isSignedIn() && (canAccessData(resource.data) || request.auth.uid == resource.data.tenantId);
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, delete: if isSignedIn() && canAccessData(resource.data);
      allow create: if isSignedIn() && canAccessData(request.resource.data);
      allow update: if isSignedIn() && canAccessData(resource.data);
    }

    // Schedules Collection
    match /schedules/{scheduleId} {
      allow read, delete: if isSignedIn() && canAccessData(resource.data);
      allow create: if isSignedIn() && canAccessData(request.resource.data);
      allow update: if isSignedIn() && canAccessData(resource.data);
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read, delete: if isSignedIn() && (canAccessData(resource.data) || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (canAccessData(request.resource.data) || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && (canAccessData(resource.data) || resource.data.userId == request.auth.uid);
    }

    // -------------------------------------------------------------
    // OPERASIONAL ARENA & GOR (COURTS, BOOKINGS, TRANSACTIONS, POS, LEDGER)
    // -------------------------------------------------------------

    // Courts Collection
    match /courts/{courtId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Products Collection (POS & Inventory)
    match /products/{productId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // POS Transactions Collection
    match /pos_transactions/{document=**} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Global Ledger Collection
    match /global_ledger/{document=**} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // -------------------------------------------------------------
    // MODUL AKADEMI OLAHRAGA (ACADEMIES, STUDENTS, COACHES, CLASSES, ETC)
    // -------------------------------------------------------------

    // Academies Collection
    match /academies/{academyId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Students Collection
    match /students/{studentId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Coaches Collection
    match /coaches/{coachId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Academy Classes Collection
    match /academy_classes/{classId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Attendances Collection
    match /attendances/{attendanceId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Academy Attendance Collection
    match /academy_attendance/{document=**} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Academy Evaluations Collection
    match /academy_evaluations/{document=**} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Growth Logs Collection
    match /growth_logs/{logId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // SPP Payments Collection
    match /spp_payments/{paymentId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // -------------------------------------------------------------
    // MODUL EVENT & TURNAMEN (EVENTS, SPONSORS, SPONSORSHIPS, ETC)
    // -------------------------------------------------------------

    // Events Collection
    match /events/{eventId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Sponsors Collection
    match /sponsors/{sponsorId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Sponsorships Collection
    match /sponsorships/{sponsorshipId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Event Documents Collection
    match /event_documents/{documentId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Event Categories Collection
    match /event_categories/{categoryId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Event Registrations Collection
    match /event_registrations/{registrationId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Event Expenses Collection
    match /event_expenses/{expenseId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

    // Event Matches & Bracket Collection
    match /event_matches/{matchId} {
      allow read, delete: if canAccessData(resource.data);
      allow create: if canAccessData(request.resource.data);
      allow update: if canAccessData(resource.data);
    }

  }
}
