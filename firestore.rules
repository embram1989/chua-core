rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'embram1989@gmail.com';
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Invitations Collection
    match /invitations/{invitationId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Tenants Collection
    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerEmail == request.auth.token.email;
      allow update, delete: if isSuperAdmin() || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
    }

    // Courts Collection
    match /courts/{courtId} {
      allow read, write: if isSignedIn();
    }

    // Products Collection
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read, write: if isSignedIn();
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    // Students Collection
    match /students/{studentId} {
      allow read, write: if isSignedIn();
    }

    // Coaches Collection
    match /coaches/{coachId} {
      allow read, write: if isSignedIn();
    }

    // Academy Classes Collection
    match /academy_classes/{classId} {
      allow read, write: if isSignedIn();
    }

    // Attendances Collection
    match /attendances/{attendanceId} {
      allow read, write: if isSignedIn();
    }

    // Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read, write: if isSignedIn();
    }

    // SPP Payments Collection
    match /spp_payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    // Events Collection
    match /events/{eventId} {
      allow read, write: if isSignedIn();
    }

    // Sponsors Collection
    match /sponsors/{sponsorId} {
      allow read, write: if isSignedIn();
    }

    // Event Documents Collection
    match /event_documents/{documentId} {
      allow read, write: if isSignedIn();
    }

    // Event Categories Collection
    match /event_categories/{categoryId} {
      allow read, write: if isSignedIn();
    }

    // Event Registrations Collection
    match /event_registrations/{registrationId} {
      allow read, write: if isSignedIn();
    }

    // Event Expenses Collection
    match /event_expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    // Event Matches & Bracket Collection
    match /event_matches/{matchId} {
      allow read, write: if isSignedIn();
    }

    // POS Transactions Collection
    match /pos_transactions/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Global Ledger Collection
    match /global_ledger/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Academies Collection (Enterprise Fase 11 Multi-Academy Workspace)
    match /academies/{academyId} {
      allow read, write: if isSignedIn();
    }

    // Academy Attendance Collection (Enterprise Fase 11 Part 2)
    match /academy_attendance/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Academy Evaluations Collection (Enterprise Fase 11 Part 3)
    match /academy_evaluations/{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
